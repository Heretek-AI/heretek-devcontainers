# .env.example — Heretek devcontainers secrets template (Wave 1)
#
# Copy to `.env` and replace every CHANGEME_ placeholder with a real secret:
#   cp .env.example .env
#
# SECURITY CONTRACT (enforced fail-closed by scripts/verify-stack.ts):
# - `.env.example` MUST keep CHANGEME_ placeholders (it is only a template).
# - A real `.env` MUST NOT contain any CHANGEME_ token; the verifier rejects it
#   under rule ENV_PLACEHOLDER_LEAK. Never commit a populated `.env`.

# BIFROST_API_KEY — API key served/required by the Bifrost LLM gateway
# (compose/core.yml `bifrost` service). Replace before first `up`.
BIFROST_API_KEY=CHANGEME_bifrost_key

# OPENROUTER_API_KEY — OpenRouter key for tier-2 cloud fallback
# (see compose/bifrost.yaml providers.openrouter). Get one at https://openrouter.ai.
OPENROUTER_API_KEY=CHANGEME_openrouter_key

# GHIDRA_MCP_AUTH_TOKEN — bearer token guarding the Ghidra MCP headless server
# (Wave 2 compose/profile-appsec.yml `ghidra-mcp` service). Mandatory at runtime.
GHIDRA_MCP_AUTH_TOKEN=CHANGEME_ghidra_token

# SEARXNG_SECRET — SearXNG instance secret used for session/hash signing
# (Wave 2 compose/profile-research.yml `searxng` service). Any long random string.
SEARXNG_SECRET=CHANGEME_searxng_secret

# NATS_PASSWORD — password for the JetStream/NATS core message bus
# (compose/core.yml `nats` service). Client connections authenticate with it.
NATS_PASSWORD=CHANGEME_nats_password

# AGENTGATEWAY_ADMIN_KEY / AGENTGATEWAY_AGENT_KEY — API keys for the two
# agentgateway roles (compose/agentgateway.yaml): `admin` may call every MCP
# tool and the LLM route; `agent` is limited by the CEL rules in that file.
# Clients send them as `Authorization: Bearer <key>`.
AGENTGATEWAY_ADMIN_KEY=CHANGEME_agentgateway_admin_key
AGENTGATEWAY_AGENT_KEY=CHANGEME_agentgateway_agent_key
