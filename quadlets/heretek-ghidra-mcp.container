# quadlets/heretek-ghidra-mcp.container — on-demand Ghidra MCP server (rootless Podman quadlet)
#
# Socket-activated: heretek-ghidra-mcp-proxy.socket owns 127.0.0.1:8089. The
# first connection starts heretek-ghidra-mcp-proxy.service (systemd-socket-proxyd),
# which Requires= this unit, so the container is started on demand and proxied
# to its container-only port 127.0.0.1:18089. When the proxy exits after
# --exit-idle-time with no connections, nothing needs this unit any more and
# StopWhenUnneeded=true stops the container: 0 MB RAM while idle. This unit has
# no [Install] section on purpose — it must never start at login.
#
# Image: localhost/heretek/ghidra-mcp:6.0.0, the same pinned local build as
# compose/profile-appsec.yml. Build it once before enabling the socket:
#   podman build -t localhost/heretek/ghidra-mcp:6.0.0 images/ghidra-mcp
#
# The mandatory bearer token is NOT stored here. Provide it via a user-owned
# environment file (the container refuses to start without it):
#   printf 'GHIDRA_MCP_AUTH_TOKEN=<secret>\n' > ~/.config/heretek/ghidra-mcp.env
#   chmod 600 ~/.config/heretek/ghidra-mcp.env
#
# Install (see README "Quadlets"):
#   cp quadlets/heretek-ghidra-mcp.container ~/.config/containers/systemd/
#   cp quadlets/heretek-ghidra-mcp-proxy.socket quadlets/heretek-ghidra-mcp-proxy.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now heretek-ghidra-mcp-proxy.socket
#
# SELinux: default container_t confinement (no SecurityLabelType override).

[Unit]
Description=Heretek Ghidra MCP headless server (socket-activated, stops when idle)
After=network-online.target
Wants=network-online.target
StopWhenUnneeded=true

[Container]
Image=localhost/heretek/ghidra-mcp:6.0.0
Pull=never
ContainerName=heretek-ghidra-mcp
User=1000:1000
EnvironmentFile=%h/.config/heretek/ghidra-mcp.env
Environment=GHIDRA_MCP_ALLOWED_HOSTS=localhost,127.0.0.1
PublishPort=127.0.0.1:18089:8089
Volume=heretek-ghidra-data:/data:Z
DropCapability=ALL
NoNewPrivileges=true
HealthCmd=bash -c 'exec 3<>/dev/tcp/127.0.0.1/8089'
HealthInterval=10s
HealthStartPeriod=120s
Notify=healthy

[Service]
Restart=on-failure
TimeoutStartSec=600
